{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "kanriNo": { "type": "string" },
      "workName": { "type": "string" },
      "jobId": { "type": "string" },
      "manual": { "type": "boolean" },
      "scheduledTime": {
        "type": "string",
        "pattern": "^(AM|PM|([0-1]?[0-9]|2[0-3]):[0-5][0-9])$"
      },
      "kanshiTime": {
        "type": "string",
        "pattern": "^([0-9]{1,2}:[0-9]{2})$"
      }
    },
    "required": ["kanriNo", "workName"]
  }
}
