{
  "name": "operationelectronapp",
  "version": "0.0.20",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --mode development",
    "build": "tsc -b && vite build",
    "type-check": "tsc -b --noEmit",
    "lint": "eslint .",
    "package": "npm run build && electron-builder --publish never",
    "release": "node scripts/bump-version.js && npm run package && node scripts/release.js"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "basic-ftp": "^6.2.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^13.0.0",
    "fs-extra": "^11.4.0",
    "iconv-lite": "^0.7.3",
    "keytar": "^7.9.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.0.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "immer": "^11.1.16",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "zustand": "^5.0.14"
  },
  "build": {
    "appId": "com.operationelectronapp.app",
    "productName": "OperationElectronApp",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/google-oauth-credentials.json",
        "to": "google-oauth-credentials.json"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
