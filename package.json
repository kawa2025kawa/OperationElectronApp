{
  "name": "operationelectronapp",
  "version": "0.0.62",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --mode development",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -p electron --noEmit && tsc -p src/renderer --noEmit",
    "lint": "eslint .",
    "package": "npm run build && electron-builder --publish never",
    "release": "node scripts/bump-version.js && npm run package && node scripts/release.js",
    "prod": "npm run build && electron ./dist-electron/main.js",
    "prod:pack": "npm run build && electron-builder --dir && powershell -c \"ii release\\win-unpacked\\*.exe\""
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@holiday-jp/holiday_jp": "^2.5.2",
    "archiver": "^7.0.1",
    "basic-ftp": "^6.2.0",
    "electron-store": "^12.0.0",
    "electron-window-state": "^5.0.3",
    "exceljs": "^4.4.0",
    "fs-extra": "^11.4.0",
    "google-auth-library": "^11.3.0",
    "iconv-lite": "^0.7.3",
    "papaparse": "^5.7.1",
    "playwright": "^1.62.1",
    "semver": "^7.8.6"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/archiver": "^7.0.0",
    "@types/electron-window-state": "^2.0.34",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/semver": "^7.8.0",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.0.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "immer": "^11.1.16",
    "motion": "^14.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "zustand": "^5.0.14"
  },
  "build": {
    "appId": "com.operationelectronapp.app",
    "productName": "OperationElectronApp",
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/afterPack.js",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!**/*.map",
      "!**/node_modules/**/*.d.ts",
      "!**/node_modules/**/*.md",
      "!**/node_modules/**/LICENSE*",
      "!**/node_modules/**/CHANGELOG*",
      "!**/node_modules/exceljs/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/google-oauth-credentials.json",
        "to": "google-oauth-credentials.json"
      }
    ],
    "asar": true,
    "electronLanguages": [
      "ja"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}